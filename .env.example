DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/taskapp?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/taskapp?sslmode=require"
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST=true
SEED_ADMIN_EMAIL="admin@taskapp.local"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="System Admin"
SEED_MEMBER_PASSWORD="change-me"

# Time zone that defines "a day" for attendance tracking (the server runs in UTC on Vercel).
APP_TIME_ZONE="Asia/Karachi"

# Email (Resend via Vercel Marketplace). Without RESEND_API_KEY, emails are logged to the console in development.
RESEND_API_KEY=""
EMAIL_FROM="AI Research Lab <notifications@yourdomain.com>"
# Absolute URL used in email links (defaults to the request host, then the Vercel production URL).
APP_URL="http://localhost:3100"
