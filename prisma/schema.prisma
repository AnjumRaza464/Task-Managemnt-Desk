generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkSessionEnd {
  LOGOUT
  TIMEOUT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  TASK_OVERDUE
  TASK_DUE_TODAY
  COMMENT_ADDED
  SYSTEM
  FILE_SHARED
  MENTIONED
  PROJECT_ADDED
  TASK_UNBLOCKED
  MILESTONE_REACHED
}

enum ProjectRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String?
  role           Role      @default(MEMBER)
  designation    String?
  department     String?
  phone          String?
  avatarUrl      String?
  isActive       Boolean   @default(true)
  lastSeenAt     DateTime?
  /**
   * When the user last opened the shared team channel.
   */
  teamChatReadAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  plans            MonthlyPlan[]
  assignedTasks    Task[]                @relation("TaskAssignee")
  createdTasks     Task[]                @relation("TaskCreator")
  comments         Comment[]
  attachments      Attachment[]
  activityLogs     ActivityLog[]
  notifications    Notification[]
  sentMessages     ChatMessage[]         @relation("MessageSender")
  receivedMessages ChatMessage[]         @relation("MessageRecipient")
  workSessions     WorkSession[]
  sharedFiles      SharedFile[]          @relation("SharedFileOwner")
  receivedFiles    SharedFileRecipient[]
  taskAssignments  TaskAssignee[]        @relation("TaskAssigneeUser")
  assignmentsMade  TaskAssignee[]        @relation("TaskAssigneeBy")
  workspaces       Workspace[]
  createdProjects  Project[]
  projectMembers   ProjectMember[]       @relation("ProjectMemberUser")
  membersAdded     ProjectMember[]       @relation("ProjectMemberBy")
  mentions         CommentMention[]

  @@index([role, isActive])
}

/**
 * Top level of the project hierarchy: Workspace -> Project -> List -> Task -> SubTask.
 */
model Workspace {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#6366f1")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User      @relation(fields: [createdById], references: [id])
  projects  Project[]
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String        @default("#6366f1")
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  dueDate     DateTime?
  position    Int           @default(0)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User            @relation(fields: [createdById], references: [id])
  members       ProjectMember[]
  lists         List[]
  tasks         Task[]
  milestones    Milestone[]
  comments      Comment[]
  activity      ActivityLog[]
  notifications Notification[]

  @@unique([workspaceId, name])
  @@index([workspaceId, position])
}

/**
 * Who belongs to a project and what they may do there. Global admins and
 * managers have access to every project without a row.
 */
model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  addedById String?
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("ProjectMemberBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([projectId, userId])
  @@index([userId])
}

/**
 * A list / section inside a project (e.g. "Backlog", "This week", "Packaging").
 */
model List {
  id        String   @id @default(cuid())
  projectId String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, position])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, position])
}

/**
 * Every person a task is assigned to. The task's `assigneeId` is the primary
 * assignee (whose monthly plan holds the task) and always has a row here too.
 */
model TaskAssignee {
  taskId       String
  userId       String
  assignedById String?
  createdAt    DateTime @default(now())

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User  @relation("TaskAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("TaskAssigneeBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([taskId, userId])
  @@index([userId])
}

/**
 * `blocked` cannot be completed until `blocker` is.
 */
model TaskDependency {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker Task @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Task @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model MonthlyPlan {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  month     Int
  title     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, year, month])
  @@index([year, month])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id                  String     @id @default(cuid())
  title               String
  description         String?
  planId              String
  /**
   * Primary assignee; see TaskAssignee for everyone the task is assigned to.
   */
  assigneeId          String
  createdById         String
  categoryId          String?
  projectId           String?
  listId              String?
  milestoneId         String?
  priority            Priority   @default(MEDIUM)
  status              TaskStatus @default(PENDING)
  completion          Int        @default(0)
  startDate           DateTime?
  dueDate             DateTime
  completedAt         DateTime?
  position            Int        @default(0)
  /**
   * Repeat rule; the next occurrence is created when this one is completed.
   */
  recurrence          Recurrence @default(NONE)
  recurrenceEndsAt    DateTime?
  /**
   * The first task in a repeating series (null for the first one itself).
   */
  recurrenceParentId  String?
  /**
   * Set once the next occurrence has been created, so a re-completed task does not spawn twice.
   */
  recurrenceSpawnedAt DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  plan               MonthlyPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  assignee           User             @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy          User             @relation("TaskCreator", fields: [createdById], references: [id])
  category           Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subtasks           SubTask[]
  comments           Comment[]
  attachments        Attachment[]
  activity           ActivityLog[]
  notifications      Notification[]
  recurrenceParent   Task?            @relation("TaskRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceChildren Task[]           @relation("TaskRecurrence")
  project            Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  list               List?            @relation(fields: [listId], references: [id], onDelete: SetNull)
  milestone          Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignees          TaskAssignee[]
  blockedBy          TaskDependency[] @relation("Blocked")
  blocks             TaskDependency[] @relation("Blocker")

  @@index([assigneeId, status])
  @@index([planId])
  @@index([projectId, listId, position])
  @@index([milestoneId])
  @@index([dueDate])
  @@index([status, priority])
}

model SubTask {
  id          String   @id @default(cuid())
  taskId      String
  title       String
  isCompleted Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/**
 * A comment on a task or a project discussion. Replies set `parentId`.
 */
model Comment {
  id        String   @id @default(cuid())
  taskId    String?
  projectId String?
  parentId  String?
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task     Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project  Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[]        @relation("CommentReplies")
  author   User             @relation(fields: [authorId], references: [id])
  mentions CommentMention[]

  @@index([taskId])
  @@index([projectId])
  @@index([parentId])
}

model CommentMention {
  commentId String
  userId    String

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

model Attachment {
  id           String   @id @default(cuid())
  taskId       String
  uploadedById String
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String
  taskId    String?
  projectId String?
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  actor   User     @relation(fields: [actorId], references: [id])
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([projectId, createdAt])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  taskId    String?
  projectId String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  dedupeKey String?          @unique
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model ChatMessage {
  id          String    @id @default(cuid())
  senderId    String
  /**
   * Null for messages posted in the shared team channel.
   */
  recipientId String?
  content     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender    User  @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User? @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

/**
 * A continuous stretch of portal use, used for check-in / check-out tracking.
 * Opened at sign-in (or when activity resumes after a long idle gap or on a new
 * day) and closed at sign-out or once the user goes idle.
 */
model WorkSession {
  id            String          @id @default(cuid())
  userId        String
  /**
   * Identifies the sign-in (kept in the JWT); one sign-in may span several sessions.
   */
  loginId       String
  /**
   * False for a real sign-in, true when the session was reopened after an idle gap.
   */
  resumed       Boolean         @default(false)
  startedAt     DateTime        @default(now())
  lastActiveAt  DateTime        @default(now())
  endedAt       DateTime?
  endReason     WorkSessionEnd?
  /**
   * Time the user was actually active (tab visible and recently interacted with).
   */
  activeSeconds Int             @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([loginId, startedAt])
  @@index([startedAt])
}

/**
 * A document, PDF or image a manager shares with every user or with chosen users.
 */
model SharedFile {
  id         String   @id @default(cuid())
  sharedById String
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  /**
   * Optional message shown next to the file.
   */
  note       String?
  /**
   * True when every active user can see it; otherwise only the recipients.
   */
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())

  sharedBy   User                  @relation("SharedFileOwner", fields: [sharedById], references: [id], onDelete: Cascade)
  recipients SharedFileRecipient[]

  @@index([sharedById, createdAt])
  @@index([isPublic, createdAt])
}

/**
 * Who a file was shared with, and when they first opened it. For public files
 * a row is only created once the user opens the file.
 */
model SharedFileRecipient {
  fileId   String
  userId   String
  viewedAt DateTime?

  file SharedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([fileId, userId])
  @@index([userId])
}
